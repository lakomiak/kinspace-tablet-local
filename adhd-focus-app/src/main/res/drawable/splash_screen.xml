<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Brand background -->
    <item android:drawable="@color/brand_background"/>

    <!-- Keep the launch splash simple and smaller so Android does not crop or soften it. -->
    <item
        android:gravity="center"
        android:width="196dp"
        android:height="196dp">
        <bitmap
            android:src="@drawable/kinspace_logo"
            android:gravity="center"
            android:tileMode="disabled"/>
    </item>
</layer-list>
